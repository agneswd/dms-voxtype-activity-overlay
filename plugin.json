{
  "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
  "id": "voxtypeActivityOverlay",
  "name": "VoxType Activity Overlay",
  "description": "Live microphone activity overlay while VoxType is recording. Shows frequency bars or a scrolling waveform, a cancel button, a transcribing spinner in the visualizer, and the final transcript.",
  "version": "1.3.1",
  "author": "agneswd",
  "license": "MIT",
  "type": "daemon",
  "capabilities": ["daemon"],
  "component": "./DmsVoxtypeActivityOverlay.qml",
  "settings": "./DmsVoxtypeActivityOverlaySettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "mic",
  "requires_dms": ">=1.5.0",
  "requires": ["voxtype", "cava"],
  "dependencies": ["voxtype", "cava"],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
